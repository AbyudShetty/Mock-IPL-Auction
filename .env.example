# Firebase Configuration
# Copy this file to .env and fill in your Firebase project values.
# For local dev, firebase-init.js has built-in defaults.
# For production deployments, set window.__FIREBASE_CONFIG__
# by injecting these values via CI/CD or a build script.

FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.region.firebasedatabase.app
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=1:your_app_id
FIREBASE_MEASUREMENT_ID=G-your_measurement_id
