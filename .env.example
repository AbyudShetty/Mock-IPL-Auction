# Firebase Web SDK configuration.
# Copy to .env and fill in to point the app at your own Firebase project.
# Vite only exposes variables prefixed with VITE_ to the client bundle.
#
# These values are NOT secrets — a Firebase web config is public by design.
# Access control belongs in your Realtime Database security rules.
#
# Leave the file out entirely and src/firebase/client.js falls back to the
# existing goated-auction-2b1d8 project.

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.region.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=1:your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-your_measurement_id
